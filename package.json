{
  "name": "youhavebeenstaring-plugin",
  "version": "1.2.1",
  "description": "This plugin tells you in the status bar for how long you've been staring at your obsidian vault. Well - at least how long your vault is open.",
  "main": "main.js",
  "scripts": {
    "dev": "esbuild main.ts --bundle --external:obsidian --format=cjs --target=es2018 --sourcemap=inline --outfile=main.js --watch",
    "build": "tsc -noEmit -skipLibCheck && esbuild main.ts --bundle --external:obsidian --format=cjs --target=es2018 --outfile=main.js"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^14.14.2",
    "esbuild": "^0.25.0",
    "obsidian": "https://github.com/obsidianmd/obsidian-api/tarball/master",
    "tslib": "^2.0.3",
    "typescript": "^4.0.3"
  }
}
